[Unit]
Description=AD4M Executor (Local-Only Mobile Build)
After=graphical.target

[Service]
Type=simple
ExecStart=/usr/bin/ad4m run --connect-holochain false --run-dapp-server true --port 12000
Restart=always
RestartSec=5
MemoryMax=3G
User=user
Environment=RUST_LOG=info
Environment=HOME=/home/user

[Install]
WantedBy=multi-user.target
