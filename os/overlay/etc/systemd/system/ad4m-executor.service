[Unit]
Description=AD4M Executor (Local-Only Mobile Build)
After=graphical.target

[Service]
Type=simple
ExecStart=/usr/bin/ad4m-executor run --run-dapp-server true --port 12000
Restart=always
RestartSec=5
MemoryMax=3G
User=user
Environment=RUST_LOG=info
Environment=HOME=/home/user
Environment=LD_PRELOAD=/usr/lib/libglibc_stubs.so

[Install]
WantedBy=multi-user.target
